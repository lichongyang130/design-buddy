# Example only. Copy to an ignored local environment file; never commit a real key.
# For discovery, export these variables in your shell, or use Node's --env-file.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible base URL override:
# LLM_BASE_URL=https://api.deepseek.com/v1

# App backend (node --env-file=.env.local server.mjs). Never use VITE_ for secrets.
OPENAI_API_KEY=
# Optional other OpenAI-compatible provider; HTTPS public hosts only:
MODEL_API_KEY=
MODEL_BASE_URL=
# Comma-separated additional approved hosts; DeepSeek, OpenAI and discovery-api.intern-ai.org.cn are built in.
MODEL_ALLOWED_HOSTS=
